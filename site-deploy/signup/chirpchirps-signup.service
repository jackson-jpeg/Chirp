[Unit]
Description=chirpchirps.com release list signup (SQLite, loopback :3330)
After=network.target

[Service]
ExecStart=/usr/bin/python3 -I /srv/chirpchirps/signup_server.py
Environment=PORT=3330 SIGNUP_DB=/var/lib/chirpchirps/signups.db
DynamicUser=yes
StateDirectory=chirpchirps
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5
Nice=10
CPUQuota=10%
MemoryMax=100M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_UNIX

[Install]
WantedBy=multi-user.target
